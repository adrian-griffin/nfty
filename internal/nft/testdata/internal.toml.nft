#!/usr/sbin/nft -f

table ip nfty-default
delete table ip nfty-default
table ip6 nfty-default
delete table ip6 nfty-default

table ip nfty-default {
	set dns {
		type ipv4_addr
		flags interval
		auto-merge
		comment "nfty: DNS allowlist - keep restricted"
		elements = { 10.100.1.0/24, 172.16.1.0/24 }
	}

	set snmp {
		type ipv4_addr
		flags interval
		auto-merge
		comment "nfty: SNMP for monitoring"
		elements = { 172.16.1.5 }
	}

	set ssh {
		type ipv4_addr
		flags interval
		auto-merge
		comment "nfty: SSH allowlist"
		elements = { 10.100.1.5 }
	}

	set webui {
		type ipv4_addr
		flags interval
		auto-merge
		comment "nfty: Web UI allowlist"
		elements = { 10.100.1.0/24, 172.16.1.0/24 }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" counter accept comment "nfty:d: allow loopback"
		udp sport 67 udp dport 68 counter accept comment "nfty:d: allow DHCPv4 client"
		meta l4proto icmp limit rate 10/second counter accept comment "nfty:d: icmp rate limit"
		meta l4proto icmp counter drop comment "nfty:d: icmp over limit"
		ct state established,related counter accept comment "nfty:d: allow established"
		ct state invalid counter drop comment "nfty:d: drop invalid"
		tcp dport 22 ip saddr @ssh counter accept comment "nfty: SSH"
		tcp dport { 80, 443 } ip saddr @webui counter accept comment "nfty: Pihole web UI"
		tcp dport 53 ip saddr @dns counter accept comment "nfty: DNS - tcp + udp"
		udp dport 53 ip saddr @dns counter accept comment "nfty: DNS - tcp + udp"
		udp dport 161 ip saddr @snmp counter accept comment "nfty: SNMP polling"
		tcp dport 22 counter log prefix "NFTY DROP 22/TCP: " comment "nfty:d: SSH log"
		tcp dport 22 counter drop comment "nfty:d: SSH drop"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related counter accept comment "nfty:d: allow established"
		ct state invalid counter drop comment "nfty:d: drop invalid"
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
	}
}

table ip6 nfty-default {
	set dns {
		type ipv6_addr
		flags interval
		auto-merge
		comment "nfty: IPv6 DNS allowlist"
		elements = { 2001:db8::/64, 2001:db8::2 }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" counter accept comment "nfty:d: allow loopback"
		icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } counter accept comment "nfty:d: allow NDP"
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 counter accept comment "nfty:d: allow DHCPv6 client"
		meta l4proto ipv6-icmp limit rate 10/second counter accept comment "nfty:d: ipv6-icmp rate limit"
		meta l4proto ipv6-icmp counter drop comment "nfty:d: ipv6-icmp over limit"
		ct state established,related counter accept comment "nfty:d: allow established"
		ct state invalid counter drop comment "nfty:d: drop invalid"
		tcp dport 53 ip6 saddr @dns counter accept comment "nfty: DNS IPv6 - keep srclist tight"
		udp dport 53 ip6 saddr @dns counter accept comment "nfty: DNS IPv6 - keep srclist tight"
		tcp dport 22 counter log prefix "NFTY DROP 22/TCP: " comment "nfty:d: SSH log"
		tcp dport 22 counter drop comment "nfty:d: SSH drop"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related counter accept comment "nfty:d: allow established"
		ct state invalid counter drop comment "nfty:d: drop invalid"
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
	}
}
