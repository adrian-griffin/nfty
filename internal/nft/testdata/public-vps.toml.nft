#!/usr/sbin/nft -f

table ip nfty-public
delete table ip nfty-public
table ip6 nfty-public
delete table ip6 nfty-public

table ip nfty-public {
	set snmp {
		type ipv4_addr
		flags interval
		auto-merge
		comment "nfty: SNMP monitoring (over VPN)"
		elements = { 172.16.1.5 }
	}

	set ssh {
		type ipv4_addr
		flags interval
		auto-merge
		comment "nfty: SSH - on a public node, keep this very tight"
		elements = { 100.10.1.1, 172.16.1.0/24 }
	}

	set wg_peers {
		type ipv4_addr
		flags interval
		auto-merge
		comment "nfty: WireGuard peer endpoints"
		elements = { 100.10.1.1 }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" counter accept comment "nfty:d: allow loopback"
		udp sport 67 udp dport 68 counter accept comment "nfty:d: allow DHCPv4 client"
		meta l4proto icmp limit rate 20/second counter accept comment "nfty:d: icmp rate limit"
		meta l4proto icmp counter drop comment "nfty:d: icmp over limit"
		ct state established,related counter accept comment "nfty:d: allow established"
		ct state invalid counter drop comment "nfty:d: drop invalid"
		tcp dport 22 ip saddr @ssh counter accept comment "nfty: SSH"
		udp dport 161 ip saddr @snmp counter accept comment "nfty: SNMP"
		iifname "eth0" tcp dport { 80, 443 } ct state new limit rate 20/second burst 50 packets counter accept comment "nfty: HTTP/HTTPS - rate limite new"
		iifname "eth0" tcp dport { 80, 443 } ct state new counter drop comment "nfty: HTTP/HTTPS - rate limite new [over-limit]"
		udp dport 51820 ip saddr @wg_peers counter accept comment "nfty: WireGuard tunnel"
		tcp dport 22 counter log prefix "NFTY DROP 22/TCP: " comment "nfty:d: SSH log"
		tcp dport 22 counter drop comment "nfty:d: SSH drop"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related counter accept comment "nfty:d: allow established"
		ct state invalid counter drop comment "nfty:d: drop invalid"
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
	}
}

table ip6 nfty-public {
	set ssh {
		type ipv6_addr
		flags interval
		auto-merge
		comment "nfty: IPv6 SSH allowlist"
		elements = { 2001:db8::/64 }
	}

	set wg_peers {
		type ipv6_addr
		flags interval
		auto-merge
		comment "nfty: IPv6 WireGuard peers"
		elements = { 2001:db8::2 }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" counter accept comment "nfty:d: allow loopback"
		icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } counter accept comment "nfty:d: allow NDP"
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 counter accept comment "nfty:d: allow DHCPv6 client"
		meta l4proto ipv6-icmp limit rate 20/second counter accept comment "nfty:d: ipv6-icmp rate limit"
		meta l4proto ipv6-icmp counter drop comment "nfty:d: ipv6-icmp over limit"
		ct state established,related counter accept comment "nfty:d: allow established"
		ct state invalid counter drop comment "nfty:d: drop invalid"
		tcp dport 22 ip6 saddr @ssh counter accept comment "nfty: SSH IPv6"
		udp dport 51820 ip6 saddr @wg_peers counter accept comment "nfty: WireGuard IPv6"
		tcp dport 22 counter log prefix "NFTY DROP 22/TCP: " comment "nfty:d: SSH log"
		tcp dport 22 counter drop comment "nfty:d: SSH drop"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related counter accept comment "nfty:d: allow established"
		ct state invalid counter drop comment "nfty:d: drop invalid"
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
	}
}
