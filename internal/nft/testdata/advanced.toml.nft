#!/usr/sbin/nft -f

table ip nfty-advanced
delete table ip nfty-advanced
table ip6 nfty-advanced
delete table ip6 nfty-advanced

table ip nfty-advanced {
	set admin {
		type ipv4_addr
		flags interval
		auto-merge
		comment "nfty: admin allowlist"
		elements = { 10.100.1.5, 172.16.1.0/24 }
	}

	set blocked_dst {
		type ipv4_addr
		flags interval
		auto-merge
		comment "nfty: Outbound destinations to block"
		elements = { 192.0.2.0/24 }
	}

	set lan {
		type ipv4_addr
		flags interval
		auto-merge
		comment "nfty: LAN range"
		elements = { 10.100.0.0/16 }
	}

	chain input {
		type filter hook input priority filter + 10; policy drop;
		iif "lo" counter accept comment "nfty:d: allow loopback"
		udp sport 67 udp dport 68 counter accept comment "nfty:d: allow DHCPv4 client"
		meta l4proto icmp limit rate 100/second counter accept comment "nfty:d: icmp rate limit"
		meta l4proto icmp counter drop comment "nfty:d: icmp over limit"
		ct state established,related counter accept comment "nfty:d: allow established"
		ct state invalid counter drop comment "nfty:d: drop invalid"
		tcp dport 1024-65535 ip saddr @lan counter accept comment "nfty: Ephemeral TCP from LAN"
		tcp dport { 1000, 1001 } ip saddr 192.168.0.0/24 counter drop comment "nfty: TCP + UDP + 2 ports example"
		udp dport { 1000, 1001 } ip saddr 192.168.0.0/24 counter drop comment "nfty: TCP + UDP + 2 ports example"
		udp sport 123 counter accept comment "nfty: Allow NTP replies"
		tcp dport 22 log prefix "NFTY DROP SSH: " level warn counter drop comment "nfty: Log+drop unauthorized SSH"
		iifname "eth0" tcp dport { 80, 443 } ct state new limit rate 20/second burst 50 packets counter accept comment "nfty: HTTP/HTTPS - v4"
		iifname "eth0" tcp dport { 80, 443 } ct state new counter drop comment "nfty: HTTP/HTTPS - v4 [over-limit]"
		tcp dport 22 counter log prefix "NFTY DROP 22/TCP: " comment "nfty:d: SSH log"
		tcp dport 22 counter drop comment "nfty:d: SSH drop"
	}

	chain forward {
		type filter hook forward priority filter + 10; policy drop;
		ct state established,related counter accept comment "nfty:d: allow established"
		ct state invalid counter drop comment "nfty:d: drop invalid"
		iifname "br-lan" oifname "eth0" counter accept comment "nfty: Allow LAN to WAN"
	}

	chain output {
		type filter hook output priority filter + 10; policy accept;
		ip daddr @blocked_dst counter drop comment "nfty: Block outbound to known-bad IPs"
		ip daddr 198.51.100.7 counter drop comment "nfty: Block specific host"
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "eth0" counter masquerade comment "nfty: NAT LAN out the WAN"
	}
}

table ip6 nfty-advanced {
	set ssh {
		type ipv6_addr
		flags interval
		auto-merge
		comment "nfty: IPv6 SSH allowlist"
		elements = { 2001:db8::/64 }
	}

	chain input {
		type filter hook input priority filter + 10; policy drop;
		iif "lo" counter accept comment "nfty:d: allow loopback"
		icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } counter accept comment "nfty:d: allow NDP"
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 counter accept comment "nfty:d: allow DHCPv6 client"
		meta l4proto ipv6-icmp limit rate 100/second counter accept comment "nfty:d: ipv6-icmp rate limit"
		meta l4proto ipv6-icmp counter drop comment "nfty:d: ipv6-icmp over limit"
		ct state established,related counter accept comment "nfty:d: allow established"
		ct state invalid counter drop comment "nfty:d: drop invalid"
		iifname "eth0" tcp dport { 80, 443 } ct state new limit rate 20/second burst 50 packets counter accept comment "nfty: HTTP/HTTPS - v6"
		iifname "eth0" tcp dport { 80, 443 } ct state new counter drop comment "nfty: HTTP/HTTPS - v6 [over-limit]"
		tcp dport 22 counter log prefix "NFTY DROP 22/TCP: " comment "nfty:d: SSH log"
		tcp dport 22 counter drop comment "nfty:d: SSH drop"
	}

	chain forward {
		type filter hook forward priority filter + 10; policy drop;
		ct state established,related counter accept comment "nfty:d: allow established"
		ct state invalid counter drop comment "nfty:d: drop invalid"
	}

	chain output {
		type filter hook output priority filter + 10; policy accept;
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
	}
}
